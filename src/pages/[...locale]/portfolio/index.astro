---
import PageLayout from "@layouts/page-layout.astro";
import {DEFAULT_LOCALE, type Locale, LOCALES} from "@lib/locale.ts";
import PortfolioSection from "./portfolio-section.astro";
import bgProgramming from '@assets/portfolio_bg_programming.jpg';
import bgGroover from '@assets/portfolio_bg_groover.jpg';
import bgMusic from '@assets/portfolio_bg_music.jpg';

export function getStaticPaths() {
  return [...LOCALES.map(it => ({ params: { locale: it } })), { params: { locale: undefined } }];
}

const sections = [
  { title: { nl: "programmeren", en: "programming" }, bg: bgProgramming, speed: 0.6, category: "programming" },
  { title: { nl: "m'n studentenvereniging", en: "my association" }, bg: bgGroover, speed: 0.7, category: "association" },
  { title: { nl: "muziek", en: "music" }, bg: bgMusic, speed: 0.8, category: "music" },
]

const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as Locale;
---

<PageLayout locale={locale}>
  {sections.map(section => (
    <PortfolioSection locale={locale} background={section.bg} title={section.title[locale]} speed={section.speed} category={section.category}/>
  ))}
</PageLayout>

<style>
  a {
    font-family: var(--font-thomas-title), serif;
    font-weight: var(--font-weight-bold);
    padding-bottom: 0.6rem;
    text-decoration-line: none;
    color: white;
  }
</style>