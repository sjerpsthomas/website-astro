---
import PageLayout from "@layouts/page-layout.astro";
import {DEFAULT_LOCALE, type Locale, LOCALES} from "@lib/locale.ts";
import type { CollectionEntry } from "astro:content";
import { getEntry, render } from 'astro:content';
import profilePhoto from '@assets/profile_photo.jpg';
import {Image} from "astro:assets";

export function getStaticPaths() {
  return [...LOCALES.map(it => ({params: {locale: it}})), {params: {locale: undefined}}];
}

const locale = (Astro.params.locale ?? DEFAULT_LOCALE) as Locale;

const entry: CollectionEntry<'home'> = await getEntry('home', locale)!;
const { Content } = await render(entry);
---

<PageLayout locale={locale}>
  <section class="flex lg:flex-row flex-col justify-center items-center mt-5">
    <Image class="size-[12rem] m-5 rounded-2xl" src={profilePhoto} alt="Thomas Sjerps"/>
    <div class="max-w-100 p-8 m-5 rounded-2xl bg-gray-800">
      <Content/>
    </div>
  </section>
</PageLayout>
