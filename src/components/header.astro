---
import {type Locale} from "@lib/locale";
import shirt from '@assets/shirt-2.png';
import {getDictKeys} from "@lib/utils";

type Props = {
  locale: Locale,
}
const { locale } = Astro.props;

const dict = {
  nl: [
    { title: "HOME", href: "", description: "Home sweet home." },
    { title: "CV", href: "cv", description: "Recruiters welkom!" },
    { title: "PORTFOLIO", href: "portfolio", description: "Waar hou ik nou *echt* van?" },
  ],
  en: [
    { title: "HOME", href: "", description: "Home sweet home." },
    { title: "CV", href: "cv", description: "Recruiters welcome!" },
    { title: "PORTFOLIO", href: "portfolio", description: "What do I *really* love?" },
  ]
}[locale]

const localeHref = locale === 'nl' ? '/' : `/en/`;
const otherLocaleHref = locale === 'nl' ? `/en/` : '/';

const currentPath = Astro.url.pathname;
const currentPage = ("/" + currentPath).split('/').at(-1)
console.log(currentPage);
---


<header class="print:hidden flex flex-wrap lg:flex-row flex-col items-center justify-center bg-gray-900 py-10 bg-center bg-cover" style={{ backgroundImage: `linear-gradient(to bottom, rgba(0,0,0,0.0),rgba(0,0,0,0.4)), url(${shirt.src})` }}>
  <a href={otherLocaleHref + currentPage} class="header-item flex flex-row items-center space-x-1 !px-5 !pb-2">
    <span class={locale == "nl" ? "font-bold lg:!text-lg !text-sm" : "font-light opacity-70 !text-sm"}>NL</span>
    <span class="font-light opacity-50 !text-sm">/</span>
    <span class={locale == "en" ? "font-bold lg:!text-lg !text-sm" : "font-light opacity-70 !text-sm"}>EN</span>
  </a>

  {dict.map((pageDict) => {
    if (pageDict.href == currentPage) {
      return (
        <div class="header-item bg-black text-center rounded-3xl px-8 py-2 pb-3 shadow-xl">
          <h1 class="lg:!text-6xl !text-4xl !mb-2 font-black">{pageDict.title}</h1>
          <p>
            {pageDict.description}
          </p>
        </div>
      );
    }

    return (
      <a href={localeHref + pageDict.href} class="header-item">
        <span>{pageDict.title}</span>
      </a>
    );
  })}
</header>


<style>
  @import '@styles/global.css';
  a {
    @apply bg-black text-center rounded-full px-10 py-2 pb-3 lg:text-2xl text-xl font-bold !text-white !no-underline hover:scale-105 hover:shadow-md transition-all;
    font-family: var(--font-thomas-title), serif;
  }

  .header-item {
    @apply mx-3 my-1;
  }
</style>
