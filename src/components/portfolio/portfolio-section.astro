---
import Slideshow from "./portfolio-slideshow.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../lib/locale";
import type { ImageMetadata } from "astro";

type Props = {
  title: string;
  background: ImageMetadata;
  locale: Locale;
  speed: number;
  category: string;
};
const { title, background, locale, speed, category } = Astro.props;

const iLoveText = { nl: "ik hou van", en: "i love" };

const items: CollectionEntry<"portfolio">[] = await getCollection(
  "portfolio",
  ({ id, data }) => id.startsWith(`${locale}/`) && category == data.category,
);
---

<section
  class="portfolio-section h-fit"
  style={{
    backgroundImage: `linear-gradient(to right,rgba(0,0,0,0.3),black), url(${background.src})`,
    backgroundSize: "cover",
  }}
>
  <!--Slideshow with header to the left-->
  <div class="flex h-fit lg:flex-row flex-col justify-stretch lg:items-center">
    <div
      class="i-love init transition-all duration-500 lg:p-20 p-6 text-shadow-large"
    >
      <p class="-mb-1!">{iLoveText[locale]}</p>
      <h1 class="size-fit lg:text-4xl! text-3xl!">
        {title}:
      </h1>
    </div>

    <div
      class="flex-1 relative min-w-0 overflow-clip lg:rounded-l-full h-full self-stretch pointer-events-none"
    >
      <div class="absolute left-0 right-0 top-0 bottom-0 z-10">
        <div class="content-wrapper h-full"></div>
      </div>

      <Slideshow items={items} speed={speed} />
    </div>
  </div>
</section>

<script>
  import type { EmblaCarouselType } from "embla-carousel";
  const sections = document.querySelectorAll<HTMLElement>(".portfolio-section");

  sections.forEach((section) => {
    const contentWrapper = section.querySelector(
      ".content-wrapper",
    ) as HTMLElement;

    section.addEventListener("portfolio-item-select", (e) => {
      const { id, emblaApi } = (
        e as unknown as { detail: { id: string; emblaApi: EmblaCarouselType } }
      ).detail;
      const prevId = contentWrapper.dataset.activeId;
      const template = document.getElementById(
        `portfolio-content-${id}`,
      ) as HTMLTemplateElement;

      if (prevId !== id) {
        const newNode = (template.content.cloneNode(true) as DocumentFragment)
          .firstElementChild!;
        contentWrapper.appendChild(newNode);
        contentWrapper.dataset.activeId = id;

        contentWrapper.onclick = () => {
          contentWrapper.innerHTML = "";
          delete contentWrapper.dataset.activeId;
          emblaApi.plugins().autoScroll.play(0);
        };

        requestAnimationFrame(() => {
          newNode.classList.add("is-visible");
        });
      }
    });
  });

  const i_loves = document.querySelectorAll<HTMLElement>(".i-love");
  i_loves.forEach((i_love, index) => {
    setTimeout(() => {
      i_love.classList.remove("init");
    }, index * 50);
  });
</script>

<style>
  .i-love.init {
    opacity: 0;
    transform: translateY(10px);
  }

  .i-love:not(.init) {
    opacity: 1;
    transform: translateY(0);
  }
</style>
